<?xml version="1.0" encoding="utf-8"?>
<!--
    @file activity_main.xml
    @brief Pleos CommuteCare 대화면 프리미엄 인포테인먼트 UI (Apple Glassmorphism & Blue/White Tone-on-Tone)
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080D1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="24dp"
        android:paddingEnd="32dp"
        android:paddingBottom="48dp">

        <!-- ========================================== -->
        <!-- 1. Top Header Bar: Title & Vehicle Telemetry -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMainTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pleos CommuteCare"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:text="현대자동차 SDV 커넥티드카 맞춤형 프리컨디셔닝 &amp; 인포테인먼트 에이전트"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_blue"
                android:paddingStart="16dp"
                android:paddingTop="7dp"
                android:paddingEnd="16dp"
                android:paddingBottom="7dp"
                android:text="출퇴근 케어 대기 중"
                android:textColor="#60A5FA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLocationGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_card_dark"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="GPS 연동 중..."
                android:textColor="#38BDF8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_card_dark"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="14dp"
                android:paddingBottom="7dp"
                android:text="현재 차속: 0.0 km/h"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- 2. Apple Glassmorphic Personal Greeting Card -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layoutGreetingCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_briefing"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/tvGreetingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="민석님, 안녕하세요! ✨"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGreetingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:text="오늘도 안전하고 쾌적한 출퇴근 여정을 위해 차량 환경을 최적화합니다."
                android:textColor="#93C5FD"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- 3. Voice Control Bar (Max 3 Action Controls) -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/tvVoiceStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pleos 음성 비서 준비 완료 (온디바이스)"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVoiceMic"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_blue"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="음성 명령 시작"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnVoiceStop"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="음성 중지"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnVoiceReplay"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="브리핑 다시 듣기"
                android:textColor="#60A5FA"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- 4. Navigation & Showcase Bar (Max 3 Buttons) -->
        <!-- ========================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="22dp"
            android:paddingTop="12dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvNaviStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="[내비게이션] Pleos NaviHelper: 미설정 (지능형 자율 추론 대기)"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Exactly 3 action buttons to meet max 3 per screen rule -->
            <Button
                android:id="@+id/btnNaviSimWork"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="내비 출근 설정"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnNaviSimTravel"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_dark"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="내비 여행 설정"
                android:textColor="#38BDF8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnJudgeDemoTour"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_blue"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="심사 5단계 시연 투어"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Hidden for backwards compatibility with existing bindings -->
            <Button
                android:id="@+id/btnNaviSimClear"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="내비 해제"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ========================================== -->
        <!-- 5. Noise Safety Quick Reply (Max 3 Buttons)-->
        <!-- ========================================== -->
        <TextView
            android:id="@+id/tvDrivingStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="주행 제한 또는 차량 상태 확인 중입니다. 음성으로 온도 조절과 맞춤 케어를 요청할 수 있습니다."
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/layoutQuickReplyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_quick_reply"
            android:orientation="vertical"
            android:padding="22dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvQuickReplyQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="현대자동차 본사로 출근 중이십니까?"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:paddingBottom="14dp"
                android:text="차량 소음으로 음성 인식이 어려울 때 패널을 터치하여 즉시 응답할 수 있습니다."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <!-- Exactly 3 Selection Options -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnQuickReplyYes"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_blue"
                    android:text="맞춤 출근 시작"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnQuickReplyNo"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_dark"
                    android:text="일반 주행 유지"
                    android:textColor="#E2E8F0"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnQuickReplyAlt"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_dark"
                    android:text="여행 모드 전환"
                    android:textColor="#38BDF8"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ========================================== -->
        <!-- 6. Two-Column Dashboard (Apple Tone-on-Tone) -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layoutDetailedDashboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- LEFT COLUMN: AI & Personalized Care -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Card: AI Hybrid Briefing -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_briefing"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AI 맞춤 브리핑"
                        android:textColor="#60A5FA"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvWeatherDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="6dp"
                        android:text="기상청 초단기실황: 기온 2.7℃, 맑음, 습도 74%"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvAiBriefing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="14dp"
                        android:text="AI 브리핑 생성 대기 중..."
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnRefreshAiBriefing"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="AI 브리핑 다시 생성"
                        android:textColor="#38BDF8"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Card: Smart Commute Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="출퇴근 패턴 학습 및 스마트 감지"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCommutePrompt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:text="패턴 분석 중..."
                        android:textColor="#93C5FD"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnConfirmCommute"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_button_blue"
                        android:text="맞춤 출근 루틴 시작"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Card: Adaptive News Curation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="맞춤형 뉴스 큐레이션"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNewsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp"
                        android:text="뉴스 추천 불러오는 중..."
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNewsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:paddingBottom="12dp"
                        android:text="이 뉴스를 음성 요약 브리핑으로 들으시겠습니까?"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />

                    <!-- Max 2 Choices -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnNewsAccept"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_blue"
                            android:text="요약 브리핑 듣기"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnNewsDecline"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_dark"
                            android:text="건너뛰기"
                            android:textColor="#94A3B8"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- RIGHT COLUMN: Vehicle Controls & Sound -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Card: Preconditioning & Climate -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="스마트 프리컨디셔닝 및 공조 제어"
                        android:textColor="#60A5FA"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Digital Temp Display -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_temp_box"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvTargetTempDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="목표 공조: 22.0℃"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingTop="2dp"
                            android:text="출발 시각 기준 개인화 시계열 예측 반영"
                            android:textColor="#64748B"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTempDown"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_dark"
                            android:text="온도 내림 (-0.5℃)"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/btnTempUp"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_dark"
                            android:text="온도 올림 (+0.5℃)"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnPrecondition"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_button_blue"
                        android:text="공조·열선 프리컨디셔닝 실행"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Card: Interactive Ambient Mood Lamp -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="인터랙티브 앰비언트 무드램프"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLightingInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp"
                        android:text="무드램프 설정 중..."
                        android:textColor="#93C5FD"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvLightingBasis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="조명공학 및 색채심리 연구 근거 분석 중..."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Card: Psychoacoustics & YouTube Music -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="심리음향학 오디오 및 YouTube Music"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAudioInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="4dp"
                        android:text="오디오 큐레이션 설정 중..."
                        android:textColor="#E2E8F0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAcousticBasis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:text="차량 소음 마스킹 및 각성도 연구 근거..."
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnPlayMusic"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_button_blue"
                        android:text="YouTube Music 연동 재생"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Card: Weekend Resort Travel Mode -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="주말 콘도/리조트 여행 모드"
                        android:textColor="#38BDF8"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnTriggerTravelMode"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="6dp"
                        android:background="@drawable/bg_button_dark"
                        android:text="주말 콘도/리조트 여행 모드 전환"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTravelBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#CBD5E1"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ========================================== -->
        <!-- 7. System Diagnostics Console              -->
        <!-- ========================================== -->
        <LinearLayout
            android:id="@+id/layoutDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="시스템 진단 및 VHAL 통신 로그"
                android:textColor="#94A3B8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogConsole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:text="• Pleos CommuteCare 시작됨"
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
