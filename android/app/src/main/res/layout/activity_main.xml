<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_blue_white">

    <!-- 메인 대시보드 레이어 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <!-- 상단 Pleos Flo 글래스모픽 상태 바 (마스코트 플로 아바타 포함) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivHeaderMascot"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="12dp"
                    android:contentDescription="Plo Shark Mascot"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mascot_shark_2d" />

                <TextView
                    android:id="@+id/tvGreetingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="민석님 안녕하세요"
                    android:textColor="#0F172A"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_glass_apple_pill"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="Pleos Flo · 플로"
                    android:textColor="#2563EB"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDrivingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_glass_apple_pill"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:text="정차 중"
                    android:textColor="#1D4ED8"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWeatherDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_glass_apple_pill"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="18°C 맑음"
                android:textColor="#1E3A8A"
                android:textSize="21sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRefreshAiBriefing"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_glass_apple_pill"
                android:drawableStart="@drawable/ic_tesla_replay"
                android:drawablePadding="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="18dp"
                android:text="브리핑"
                android:textAllCaps="false"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnJudgeDemoTour"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/bg_glass_apple_blue_pill"
                android:drawableStart="@drawable/ic_tesla_play"
                android:drawablePadding="8dp"
                android:paddingStart="18dp"
                android:paddingEnd="20dp"
                android:text="시연 투어"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 메인 2열 테슬라 투명 글래스 대시보드 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- 좌측 43%: 투명 차량 애니메이션 스테이지 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"
                android:layout_weight="43"
                android:background="@drawable/bg_glass_apple_pane"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:text="0 km/h"
                        android:textColor="#2563EB"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNaviStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:text="자동 추론 대기"
                        android:textColor="#1E3A8A"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ai.pleos.commutecare.presentation.TeslaVehicleCanvasView
                    android:id="@+id/teslaVehicleView"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="8dp"
                    android:layout_weight="1" />

                <!-- 하단 아이콘 중심 3버튼 목적지 도크 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnNaviSimWork"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_apple_blue_pill"
                        android:drawableStart="@drawable/ic_tesla_nav"
                        android:drawablePadding="6dp"
                        android:drawableTint="#FFFFFF"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:text="출근"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnNaviSimTravel"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_apple_pill"
                        android:drawableStart="@drawable/ic_tesla_travel"
                        android:drawablePadding="6dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:text="여행"
                        android:textAllCaps="false"
                        android:textColor="#1E3A8A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnNaviSimClear"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_apple_pill"
                        android:drawableStart="@drawable/ic_tesla_replay"
                        android:drawablePadding="6dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:text="해제"
                        android:textAllCaps="false"
                        android:textColor="#1E3A8A"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 우측 57%: 아이콘·숫자 중심 투명 글래스 제어 패널 -->
            <LinearLayout
                android:id="@+id/layoutDetailedDashboard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="57"
                android:orientation="vertical">

                <!-- 카드 1: 공조 직접 제어 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_glass_apple_pane"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTempDown"
                        android:layout_width="76dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_glass_apple_pill"
                        android:text="-"
                        android:textColor="#1E3A8A"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTargetTempDisplay"
                        android:layout_width="170dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="22.5°C"
                        android:textColor="#0F172A"
                        android:textSize="48sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnTempUp"
                        android:layout_width="76dp"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_glass_apple_pill"
                        android:text="+"
                        android:textColor="#1E3A8A"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnPrecondition"
                        android:layout_width="wrap_content"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_glass_apple_blue_pill"
                        android:drawableStart="@drawable/ic_tesla_fan"
                        android:drawablePadding="10dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="22dp"
                        android:text="공조"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 카드 2: 비서 '플로(Plo)' 대화 & 브리핑 (대형 볼드 텍스트 적용) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_apple_pane"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="Plo Avatar"
                            android:src="@drawable/ic_mascot_shark_2d" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="플로 (Plo) 보이스 브리핑"
                            android:textColor="#1D4ED8"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAiBriefing"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginBottom="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:lineSpacingExtra="6dp"
                        android:maxLines="4"
                        android:text="민석님, 안녕하세요! 플로가 출근길 최적의 실내 환경을 준비했습니다."
                        android:textColor="#94A3B8"
                        android:textSize="26sp"
                        android:textStyle="normal" />

                    <!-- 상황별 퀵 리플라이 (3버튼 제한) -->
                    <LinearLayout
                        android:id="@+id/layoutQuickReplyCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_glass_apple_pill"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvQuickReplyQuestion"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="8dp"
                            android:text="맞춤 케어를 시작할까요?"
                            android:textColor="#0F172A"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnQuickReplyYes"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_apple_blue_pill"
                                android:text="확인"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:textSize="17sp"
                                android:textStyle="bold" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnQuickReplyAlt"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_apple_pill"
                                android:text="요약"
                                android:textAllCaps="false"
                                android:textColor="#1E3A8A"
                                android:textSize="17sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <androidx.appcompat.widget.AppCompatButton
                                android:id="@+id/btnQuickReplyNo"
                                android:layout_width="0dp"
                                android:layout_height="46dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_glass_apple_pill"
                                android:text="닫기"
                                android:textAllCaps="false"
                                android:textColor="#1E3A8A"
                                android:textSize="17sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- 음성 아이콘 바 (3버튼) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnVoiceMic"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1.4"
                            android:background="@drawable/bg_glass_apple_blue_pill"
                            android:drawableStart="@drawable/ic_tesla_mic"
                            android:drawablePadding="8dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="16dp"
                            android:text="플로야"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnVoiceReplay"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass_apple_pill"
                            android:drawableStart="@drawable/ic_tesla_replay"
                            android:drawablePadding="6dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="12dp"
                            android:text="재생"
                            android:textAllCaps="false"
                            android:textColor="#1E3A8A"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnVoiceStop"
                            android:layout_width="0dp"
                            android:layout_height="54dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass_apple_pill"
                            android:drawableStart="@drawable/ic_tesla_stop"
                            android:drawablePadding="6dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="12dp"
                            android:text="정지"
                            android:textAllCaps="false"
                            android:textColor="#1E3A8A"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 카드 3: 사운드 & 모드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_apple_pane"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvAudioInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Morning Commute · EQ"
                        android:textColor="#0F172A"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnPlayMusic"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass_apple_blue_pill"
                            android:drawableStart="@drawable/ic_tesla_play"
                            android:drawablePadding="8dp"
                            android:paddingStart="18dp"
                            android:paddingEnd="14dp"
                            android:text="음악"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnTriggerTravelMode"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass_apple_pill"
                            android:drawableStart="@drawable/ic_tesla_travel"
                            android:drawablePadding="8dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="14dp"
                            android:text="여행"
                            android:textAllCaps="false"
                            android:textColor="#1E3A8A"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnConfirmCommute"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_glass_apple_pill"
                            android:drawableStart="@drawable/ic_tesla_nav"
                            android:drawablePadding="8dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="14dp"
                            android:text="출근"
                            android:textAllCaps="false"
                            android:textColor="#1E3A8A"
                            android:textSize="19sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- 하위 호환성 및 진단용 숨김 컨테이너 (ViewBinding 무결성 유지) -->
        <LinearLayout
            android:id="@+id/layoutDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/cardModeTile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/cardBriefingTile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/cardAudioTile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLocationGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvCommutePrompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvTravelBanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvAcousticBasis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLightingInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLightingBasis"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvNewsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvNewsSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnNewsAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnNewsDecline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvVoiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvLogConsole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- 유튜브 뮤직 스타일 음성 청취 마이크 팝업 오버레이 -->
    <FrameLayout
        android:id="@+id/layoutMicListeningPopup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#660F172A"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_apple_pane"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:id="@+id/tvMicPopupStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="플로가 듣고 있어요..."
                android:textColor="#2563EB"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ai.pleos.commutecare.presentation.VoiceMicPulseView
                android:id="@+id/micPulseView"
                android:layout_width="380dp"
                android:layout_height="170dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvMicPopupTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="&quot;플로야, 오늘 출근길 브리핑 해줘&quot;"
                android:textColor="#0F172A"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 부팅 스플래시 오버레이: 2D 미니멀 선 + 첨벙 상어 마스코트 + Pleos Flo만 심플 표시 -->
    <FrameLayout
        android:id="@+id/layoutBootSplash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="visible">

        <ai.pleos.commutecare.presentation.PloOceanBootView
            android:id="@+id/oceanBootView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/layoutBootMascotContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:id="@+id/ivBootSharkMascot"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:contentDescription="Plo 2D Shark Rising"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_mascot_shark_2d" />

            <TextView
                android:id="@+id/tvBootBrandTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Pleos Flo"
                android:textColor="#0F172A"
                android:textSize="54sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBootBrandSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
